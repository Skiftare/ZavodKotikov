# Stellar Configuration
# Выберите сеть: testnet или mainnet
STELLAR_NETWORK=testnet

# Включить Stellar Payment Gateway (true/false)
USE_STELLAR_PAYMENT=true

# Адрес Stellar для получения платежей
# Для testnet можно создать на https://laboratory.stellar.org/#account-creator
# ВАЖНО: Замените на ваш реальный адрес!
STELLAR_DESTINATION_ADDRESS=GDASQP7VSASUXMQT3AGDIKOSGYT3IGD6ISWH3E2P2VF6TH4WYMXECPDX
# URL Horizon сервера (можно оставить по умолчанию)
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Интервал проверки платежей (в секундах)
PAYMENT_CHECK_INTERVAL=10

# Таймаут ожидания платежа (в секундах, 3600 = 1 час)
PAYMENT_TIMEOUT=3600

# Секретный ключ для генерации MEMO (HMAC-SHA256)
# ВАЖНО: Сгенерируйте уникальный ключ и НЕ меняйте его после деплоя!
# Для генерации используйте: python -c "import secrets; print(secrets.token_hex(32))"
MEMO_SECRET_KEY=080f00ce43b985c31f45787b4fbbd7b48c4ff5630abf5588023a2b8b1c40aca4
